# ==============================================================================
# Multimodal AI Companion - Environment Configuration Blueprint
# ==============================================================================
# Copy this file to '.env' and fill in your corresponding API keys.
# Do NOT commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LPU API (Active / Recommended for Ultra-Fast Speech & Math Reasoning)
# Get your free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Alternative / Fast General Dialogue)
# Get your free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 3. NVIDIA NIM API (Advanced Reasoning / Vision)
# Get your key at: https://build.nvidia.com/
# ------------------------------------------------------------------------------
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL_NAME=meta/llama-3.2-11b-vision-instruct
# NVIDIA_REASONING_API_KEY=
# NVIDIA_REASONING_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b

# ------------------------------------------------------------------------------
# 4. OpenAI API (Optional Standard Fallback)
# Get your key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Audio Synthesis & Speech Recognition Settings
# ------------------------------------------------------------------------------
EDGE_TTS_VOICE=en-US-AriaNeural
WHISPER_MODEL_SIZE=tiny.en

# ------------------------------------------------------------------------------
# 6. Server & Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=True
